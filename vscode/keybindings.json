[
  // M-x でコマンドパレットを開く (Emacs の M-x 相当)
  // 標準の割り当てなし
  {
    "key": "alt+x",
    "command": "workbench.action.showCommands"
  },
  // M-o で次のエディターを開く
  {
    "key": "alt+o",
    "command": "workbench.action.nextEditor"
  },
  // C-x C-f でファイル名を検索
  // C-x 単独の標準操作（切り取り）は使えなくなる
  {
    "key": "ctrl+x ctrl+f",
    "command": "workbench.action.quickOpen"
  },
  // C-x k で現在のエディターを閉じる（Chat 内ではセカンダリサイドバーを閉じる）
  // C-x 単独の標準操作（切り取り）は使えなくなる
  {
    "key": "ctrl+x k",
    "command": "workbench.action.closeActiveEditor"
  },
  {
    "key": "ctrl+x k",
    "command": "workbench.action.closeAuxiliaryBar",
    "when": "inChat"
  },
  // C-x g で行・列に移動
  {
    "key": "ctrl+x g",
    "command": "workbench.action.gotoLine"
  },
  // C-x s で現在のファイルを保存
  {
    "key": "ctrl+x s",
    "command": "workbench.action.files.save"
  },
  // C-w で切り取り
  // 標準の C-w（エディターを閉じる）は使えなくなる
  {
    "key": "ctrl+w",
    "command": "editor.action.clipboardCutAction"
  },
  // M-w でコピー
  // 標準の M-w（検索の単語単位切替）は使えなくなる
  {
    "key": "alt+w",
    "command": "editor.action.clipboardCopyAction"
  },
  // C-y で貼り付け
  // 標準の C-y（やり直し）は使えなくなる
  {
    "key": "ctrl+y",
    "command": "editor.action.clipboardPasteAction"
  },
  // C-p / C-n で前行 / 次行に移動
  // 標準はファイルを開く / 新しいファイル
  {
    "key": "ctrl+p",
    "command": "cursorUp"
  },
  {
    "key": "ctrl+n",
    "command": "cursorDown"
  },
  // C-v / M-v で次 / 前のページに移動
  // 標準の C-v（貼り付け）は使えなくなる
  {
    "key": "ctrl+v",
    "command": "cursorPageDown"
  },
  {
    "key": "alt+v",
    "command": "cursorPageUp"
  },
  // C-b / C-f で前 / 後ろに移動
  // 標準はプライマリサイドバーの表示切替 / 検索
  {
    "key": "ctrl+b",
    "command": "cursorLeft"
  },
  {
    "key": "ctrl+f",
    "command": "cursorRight"
  },
  // C-o で選択範囲を右へ単語単位で広げる
  // 標準の C-o（ファイルを開く）は使えなくなる
  {
    "key": "ctrl+o",
    "command": "cursorWordRightSelect"
  },
  // C-s / C-r で検索を開き、次 / 前の一致に移動
  // 該当する場面では標準の C-s（保存）/ C-r（最近使用した項目）は使えなくなる
  {
    "key": "ctrl+s",
    "command": "actions.find",
    "when": "editorTextFocus && !findWidgetVisible"
  },
  {
    "key": "ctrl+r",
    "command": "actions.find",
    "when": "editorTextFocus && !findWidgetVisible"
  },
  {
    "key": "ctrl+s",
    "command": "editor.action.nextMatchFindAction",
    "when": "findWidgetVisible && (editorFocus || findWidgetFocused)"
  },
  {
    "key": "ctrl+r",
    "command": "editor.action.previousMatchFindAction",
    "when": "findWidgetVisible && (editorFocus || findWidgetFocused)"
  },
  // C-g で選択解除、検索・補完・クイック入力を閉じる（Esc の一部）
  // 標準の C-g（行に移動）を無効化
  {
    "key": "ctrl+g",
    "command": "-workbench.action.gotoLine"
  },
  {
    "key": "ctrl+g",
    "command": "cancelSelection",
    "when": "editorTextFocus && editorHasSelection"
  },
  {
    "key": "ctrl+g",
    "command": "closeFindWidget",
    "when": "findWidgetVisible && (editorFocus || findWidgetFocused)"
  },
  {
    "key": "ctrl+g",
    "command": "hideSuggestWidget",
    "when": "suggestWidgetVisible && editorTextFocus"
  },
  {
    "key": "ctrl+g",
    "command": "workbench.action.closeQuickOpen",
    "when": "inQuickOpen"
  },
  // C-a / C-e で行頭 / 行末に移動
  // 標準はすべて選択 / ファイルを開く
  {
    "key": "ctrl+a",
    "command": "cursorLineStart"
  },
  {
    "key": "ctrl+e",
    "command": "cursorLineEnd"
  },
  // C-d / C-h でカーソルの右 / 左の文字を削除
  // 標準は次の一致を選択 / 置換
  {
    "key": "ctrl+d",
    "command": "deleteRight"
  },
  {
    "key": "ctrl+h",
    "command": "deleteLeft"
  },
  // C-k でカーソルから行末まで切り取り（行末では設定によって行全体を切り取り）
  // 標準の C-k で始まるショートカットは使えなくなる
  {
    "key": "ctrl+k",
    "command": "runCommands",
    "args": {
      "commands": ["cursorLineEndSelect", "editor.action.clipboardCutAction"]
    }
  },
  // C-c で Chat にフォーカス、Chat 内ではセカンダリサイドバーの最大化を切り替える
  // ターミナル以外では標準の C-c（コピー）は使えなくなる
  {
    "key": "ctrl+c",
    "command": "workbench.panel.chat.view.copilot.focus",
    "when": "!terminalFocus"
  },
  {
    "key": "ctrl+c",
    "command": "workbench.action.toggleMaximizedAuxiliaryBar",
    "when": "inChat && !terminalFocus"
  },
  // Chat にフォーカスがあるとき、C-x 1 でセカンダリサイドバーの最大化を切り替える
  {
    "key": "ctrl+x 1",
    "command": "workbench.action.toggleMaximizedAuxiliaryBar",
    "when": "inChat"
  }
]
                                          